{
  "$defs": {
    "Assertion": {
      "enum": [
        "present",
        "negated",
        "uncertain",
        "hypothetical"
      ],
      "title": "Assertion",
      "type": "string"
    },
    "ClinicalDomain": {
      "enum": [
        "condition",
        "measurement",
        "observation",
        "drug",
        "procedure",
        "unit",
        "visit",
        "all"
      ],
      "title": "ClinicalDomain",
      "type": "string"
    },
    "ClinicalEntity": {
      "additionalProperties": false,
      "description": "One auditable clinical entity mention.",
      "properties": {
        "entity_id": {
          "minLength": 1,
          "title": "Entity Id",
          "type": "string"
        },
        "mention": {
          "minLength": 1,
          "title": "Mention",
          "type": "string"
        },
        "normalized_mention": {
          "minLength": 1,
          "title": "Normalized Mention",
          "type": "string"
        },
        "base_entity": {
          "minLength": 1,
          "title": "Base Entity",
          "type": "string"
        },
        "entity_type": {
          "$ref": "#/$defs/EntityType"
        },
        "domain": {
          "$ref": "#/$defs/ClinicalDomain"
        },
        "associated_entities": {
          "items": {
            "type": "string"
          },
          "title": "Associated Entities",
          "type": "array"
        },
        "categories": {
          "items": {
            "type": "string"
          },
          "title": "Categories",
          "type": "array"
        },
        "value": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Unit"
        },
        "dose": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Dose"
        },
        "frequency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Frequency"
        },
        "route": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Route"
        },
        "method": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Method"
        },
        "visit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Visit"
        },
        "assertion": {
          "$ref": "#/$defs/Assertion"
        },
        "temporal": {
          "$ref": "#/$defs/Temporal"
        },
        "temporal_expression": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Temporal Expression"
        },
        "experiencer": {
          "$ref": "#/$defs/Experiencer"
        },
        "epistemic_status": {
          "$ref": "#/$defs/EpistemicStatus"
        },
        "source_field": {
          "$ref": "#/$defs/SourceField"
        },
        "speaker": {
          "$ref": "#/$defs/Speaker"
        },
        "sentence_id": {
          "minimum": 0,
          "title": "Sentence Id",
          "type": "integer"
        },
        "start_char": {
          "minimum": 0,
          "title": "Start Char",
          "type": "integer"
        },
        "end_char": {
          "exclusiveMinimum": 0,
          "title": "End Char",
          "type": "integer"
        },
        "evidence": {
          "minLength": 1,
          "title": "Evidence",
          "type": "string"
        },
        "confidence": {
          "maximum": 1.0,
          "minimum": 0.0,
          "title": "Confidence",
          "type": "number"
        }
      },
      "required": [
        "entity_id",
        "mention",
        "normalized_mention",
        "base_entity",
        "entity_type",
        "domain",
        "assertion",
        "temporal",
        "experiencer",
        "epistemic_status",
        "source_field",
        "speaker",
        "sentence_id",
        "start_char",
        "end_char",
        "evidence",
        "confidence"
      ],
      "title": "ClinicalEntity",
      "type": "object"
    },
    "EntityType": {
      "enum": [
        "condition",
        "symptom",
        "clinical_finding",
        "measurement",
        "drug",
        "procedure",
        "anatomy",
        "demographic",
        "unit",
        "visit",
        "other"
      ],
      "title": "EntityType",
      "type": "string"
    },
    "EpistemicStatus": {
      "enum": [
        "patient_fact",
        "differential_diagnosis",
        "general_information",
        "recommended",
        "conditional",
        "hypothetical",
        "unknown"
      ],
      "title": "EpistemicStatus",
      "type": "string"
    },
    "Experiencer": {
      "enum": [
        "patient",
        "family",
        "other",
        "unknown"
      ],
      "title": "Experiencer",
      "type": "string"
    },
    "SourceField": {
      "enum": [
        "question",
        "answer"
      ],
      "title": "SourceField",
      "type": "string"
    },
    "Speaker": {
      "enum": [
        "patient",
        "doctor"
      ],
      "title": "Speaker",
      "type": "string"
    },
    "Temporal": {
      "enum": [
        "present",
        "past",
        "future",
        "unknown"
      ],
      "title": "Temporal",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "description": "Validated extraction result for one Stage 2 input document.",
  "properties": {
    "document_id": {
      "minLength": 1,
      "title": "Document Id",
      "type": "string"
    },
    "parent_record_id": {
      "minLength": 1,
      "title": "Parent Record Id",
      "type": "string"
    },
    "source_field": {
      "$ref": "#/$defs/SourceField"
    },
    "speaker": {
      "$ref": "#/$defs/Speaker"
    },
    "normalized_text": {
      "minLength": 1,
      "title": "Normalized Text",
      "type": "string"
    },
    "sentences": {
      "items": {
        "minLength": 1,
        "type": "string"
      },
      "minItems": 1,
      "title": "Sentences",
      "type": "array"
    },
    "entities": {
      "items": {
        "$ref": "#/$defs/ClinicalEntity"
      },
      "title": "Entities",
      "type": "array"
    },
    "schema_version": {
      "default": "1.0.0",
      "minLength": 1,
      "title": "Schema Version",
      "type": "string"
    }
  },
  "required": [
    "document_id",
    "parent_record_id",
    "source_field",
    "speaker",
    "normalized_text",
    "sentences"
  ],
  "title": "ClinicalExtractionDocument",
  "type": "object"
}
