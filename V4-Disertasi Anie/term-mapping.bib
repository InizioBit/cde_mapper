	journal = {Agronomy},
	publisher = {Multidisciplinary Digital Publishing Institute},
	author = {Recha, John Walker and Olale, Kennedy O. and Sila, Andrew M. and Ambaw, Gebermedihin and Radeny, Maren and Solomon, Dawit},
	month = feb,
