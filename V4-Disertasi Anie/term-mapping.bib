	file = {Full Text:C\:\\Users\\anira\\Zotero\\storage\\RF2D9YCE\\Sugiarto et al. - 2024 - Supporting and Inhibiting Factors in Implementing Electronic Medical Records (EMR) Policy in Indones.pdf:application/pdf},
}

