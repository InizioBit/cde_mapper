	pages = {822},
	file = {Full Text PDF:C\:\\Users\\anira\\Zotero\\storage\\2ZLF3AQI\\García Fernández and Peek - 2023 - Connecting the Smart Village A Switch towards Smart and Sustainable Rural-Urban Linkages in Spain.pdf:application/pdf},
}

