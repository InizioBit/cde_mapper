@inproceedings{storck_michael_m_interoperability_2019,
	title = {Interoperability improvement of {Mobile} {Patient} {Survey} ({MoPat}) implementing fast health interoperability resources ({FHIR})},
	volume = {258},
	url = {https://www.scopus.com/inward/record.uri?eid=2-s2.0-85064219999&doi=10.3233%2F978-1-61499-959-1-141&partnerID=40&md5=21538d6e63da140b2924fb17879afaa0},
	doi = {10.3233/978-1-61499-959-1-141},
	abstract = {Despite the advances in health information technology and the increasing usage of electronic systems, syntactic and semantic interoperability between different health information systems remains challenging. An emerging standard to tackle interoperability issues is HL7 FHIR, which uses modern web technologies for communication like Representational State Transfer. The electronic patient reported outcome system Mobile Patient Survey (MoPat) was adapted to support metadata import and clinical data export using HL7 FHIR. Thereby, the data models of HL7 FHIR and MoPat were compared and the existing import and export functions of MoPat were extended to support HL7 FHIR. A test protocol including eight test datasets to proof functioning of the new features was successfully conducted. In the near future, a real time searching toolbar of FHIR metadata resources will be integrated within MoPat. MoPat FHIR import and export functions are ready to be used in a clinical setting in combination with a FHIR compliant clinical data server. © 2019 Elsevier B.V., All rights reserved.},
	author = {{Storck, Michael M.} and L., Luca, Hollenberg and M., Martin, Dugas and I., Iñaki, Soto-Rey},
	year = {2019},
	keywords = {Semantics, Electronic Health Record, Electronic Health Records, Human, Humans, Medical Computing, Information Systems, Information Use, Interoperability, Semantic Interoperability, Data Interoperability, Metadata, Case Report, Health Information Interoperability, Conference Paper, Health Informations, Medical Information System, Female, Health Information Systems, Male, Adult, Clinical Article, Health, Health Care Planning, Health Information Technologies, Health Level 7, Health Level Seven, Health Resources, Import And Exports, Outcome Assessment, Patient Reported Outcome Measures, Patient-reported Outcome, Patient-reported Outcomes, Questionnaire, Real-time Searching, Representational State Transfer, Surveys, Surveys And Questionnaires},
	pages = {141--145},
}

